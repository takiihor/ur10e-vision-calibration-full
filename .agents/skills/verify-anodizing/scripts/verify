#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 || $1 == --help ]]; then
  printf 'Usage: %s FEATURE [EVIDENCE_PARENT]\n' "$0"
  printf 'Features: doctor, navigation, calibration-setup, teaching-setup, pick-place-availability, tool-preview\n'
  [[ ${1:-} == --help ]]
  exit
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd -P)
venv="$HOME/venvs/anodizing-test-py312"
python="$venv/bin/python"
python_base=$("$python" -I -B -c 'import sys; from pathlib import Path; assert sys.implementation.name == "cpython" and sys.version_info[:2] == (3, 12); print(Path(sys._base_executable).parent.parent)')
parent=$(realpath -e -- "${2:-/tmp}")
run=$(mktemp -d -- "${parent%/}/anodizing-verify.XXXXXXXX")
printf 'Evidence: %s\n' "$run"
{
  git -C "$root" rev-parse HEAD
  git -C "$root" status --short --untracked-files=all
} > "$run/revision.txt"

# Use a private /tmp and /dev and expose only the source, Python and evidence.
# The namespace remains mandatory even when the default sandbox blocks it.
exec bwrap --unshare-net --unshare-pid --unshare-ipc --new-session --die-with-parent \
  --clearenv --setenv PATH /usr/bin:/bin \
  --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib \
  --ro-bind-try /lib64 /lib64 --ro-bind /etc /etc \
  --dev /dev --proc /proc --tmpfs /tmp \
  --ro-bind "$root" /checkout --ro-bind "$venv" "$venv" \
  --ro-bind "$python_base" "$python_base" --bind "$run" /evidence \
  --chdir /checkout -- "$python" -I -B /checkout/.agents/skills/verify-anodizing/scripts/verify.py \
  "$1" "$(readlink /proc/self/ns/net)"
